{
    "meta" : {
        "label": "Get CJA Reports",
        "description": "Get a Customer Journey Analytics report",
        "icon": "icon-adobe_analytics"
    },
    "readable": true,
    "writable": false,
    "supportAppend": false,
    "kind": "PYTHON",
    "paramsPythonSetup": "browse_cja.py",
    "params": [
        {
            "name": "version_number",
            "label": "Alpha.26",
            "type": "SEPARATOR"
        },
        {
            "name": "auth_type",
            "label": "Type of authentication",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "user_account",
                    "label": "Single Sign On"
                },
                {
                    "value": "service_account",
                    "label": "API key only"
                },
                {
                    "value": "server_to_server",
                    "label": "Server-to-Server"
                }
            ]
        },
        {
            "name": "user_account",
            "label": "User account",
            "type": "PRESET",
            "parameterSetId": "user-account",
            "visibilityCondition": "model.auth_type == 'user_account'"
        },
        {
            "name": "service_account",
            "label": "API key only",
            "type": "PRESET",
            "parameterSetId": "service-account",
            "visibilityCondition": "model.auth_type == 'service_account'"
        },
        {
            "name": "server_to_server",
            "label": "Server-to-Server",
            "type": "PRESET",
            "parameterSetId": "server-to-server",
            "visibilityCondition": "model.auth_type == 'server_to_server'"
        },
        {
            "name": "report_id",
            "label": "Report Suite ID",
            "type": "SELECT",
            "getChoicesFromPython": true,
            "triggerParameters": ["auth_type", "server_to_server", "service_account", "user_account"]
        },
        {
            "name": "report_id_manual",
            "label": " ",
            "description": "(id)",
            "type": "STRING",
            "visibilityCondition": "(model.report_id=='_dku_manual_select')"
        },
        {
            "name": "date_range",
            "label": "Date range",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": null,
                    "label": "Custom"
                },
                {
                    "value": "manual",
                    "label": "Custom (Manual)"
                },
                {
                    "value": "today",
                    "label": "Today"
                },
                {
                    "value": "yesterday",
                    "label": "Yesterday"
                },
                {
                    "value": "last_7_days",
                    "label": "Last 7 days"
                },
                {
                    "value": "last_14_days",
                    "label": "Last 14 days"
                },
                {
                    "value": "last_week",
                    "label": "Last Week"
                },
                {
                    "value": "last_30_days",
                    "label": "Last 30 days"
                },
                {
                    "value": "last_60_days",
                    "label": "Last 60 days"
                },
                {
                    "value": "last_month",
                    "label": "Last month"
                },
                {
                    "value": "last_quarter",
                    "label": "Last quarter"
                },
                {
                    "value": "last_year",
                    "label": "Last year"
                }
            ]
        },
        {
            "name": "start_date",
            "label": " ",
            "description": "From",
            "type": "DATE",
            "visibilityCondition": "model.date_range==null"
        },
        {
            "name": "manual_start_date",
            "type": "STRING",
            "label": " ",
            "description": "From",
            "visibilityCondition": "model.date_range=='manual'"
        },
        {
            "name": "end_date",
            "label": " ",
            "description": "To",
            "type": "DATE",
            "visibilityCondition": "model.date_range==null"
        },
        {
            "name": "manual_end_date",
            "type": "STRING",
            "label": " ",
            "description": "To",
            "visibilityCondition": "model.date_range=='manual'"
        },
        {
            "name": "manual-time-doc-separator",
            "type": "SEPARATOR",
            "label": " ",
            "description": "Must be in format 2024-12-31T23:59:00.000",
            "visibilityCondition": "model.date_range=='manual'"
        },
        {
            "name": "metrics_ids",
            "label": "Metric",
            "description": "",
            "type": "MULTISELECT",
            "getChoicesFromPython": true,
            "triggerParameters": ["report_id", "report_id_manual"]
        },
        {
            "name": "dimensions",
            "label": "Dimensions",
            "type": "MULTISELECT",
            "getChoicesFromPython": true,
            "triggerParameters": ["report_id", "report_id_manual"]
        },
        {
            "name": "dimension_manual",
            "label": " ",
            "description": "(id)",
            "type": "STRING",
            "visibilityCondition": "(model.dimension=='_dku_manual_select')"
        },
        {
            "name": "segment",
            "label": "Segment",
            "type": "SELECT",
            "getChoicesFromPython": true,
            "triggerParameters": ["report_id", "report_id_manual"]
        },
        {
            "name": "segment_manual",
            "label": " ",
            "description": "(id)",
            "type": "STRING",
            "visibilityCondition": "(model.segment=='_dku_manual_select')"
        },
        {
            "name": "should_add_total_row",
            "type": "BOOLEAN",
            "label": " ",
            "description": "Add a total row",
            "defaultValue": false
        },
        {
            "name": "should_provide_breakdown_data",
            "type": "BOOLEAN",
            "label": " ",
            "description": "Add a breakdown column",
            "defaultValue": false
        },
        {
            "name": "should_dump_server_result",
            "type": "BOOLEAN",
            "label": " ",
            "description": "Dump server result",
            "defaultValue": false
        }
    ]
}
